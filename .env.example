# Copier ce fichier en .env et compléter.

# Dossier de la base SQLite et des photos envoyées (disque persistant, à sauvegarder)
DATA_DIR=./storage

# URL publique du site, sans / final (sitemap.xml, liens absolus)
SITE_URL=

# Mot de passe initial de la console /admin, utilisé uniquement à la création du compte.
# Vide : un mot de passe est généré au premier démarrage et affiché dans les journaux du serveur.
# Pour le changer ensuite : console > Compte, ou `npm run admin:password -- "…"`.
ADMIN_PASSWORD=

# "true" derrière un reverse proxy (nginx, Caddy, Cloudflare) pour lire la vraie IP des visiteurs
TRUST_PROXY=false

# Notifications e-mail des devis et messages (facultatif)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=contact@sellerie-equattitud.fr
